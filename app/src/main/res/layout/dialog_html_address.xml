<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/html_form"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/html_instructions"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/html_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:inputType="textUri|textNoSuggestions"
            android:importantForAutofill="no"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:hint="@string/html_address_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#B8FFFFFF"
            android:backgroundTint="#00B7FF"
            android:textSize="14sp"
            android:nextFocusDown="@id/open_html_button" />
        <Button
            android:id="@+id/open_html_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/primary_button"
            android:text="@string/open_html"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:nextFocusUp="@id/html_url" />
    </LinearLayout>
</ScrollView>
