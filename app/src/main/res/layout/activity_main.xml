<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <SurfaceView
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/video_monitor" />

        <FrameLayout
            android:id="@+id/html_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/status_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/overlay_margin"
        android:background="@drawable/status_background"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/starting"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/menu_button"
        android:visibility="gone"
        android:layout_width="@dimen/toolbar_button_size"
        android:layout_height="@dimen/toolbar_button_size"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/overlay_margin"
        android:background="@drawable/round_button"
        android:contentDescription="@string/open_sources"
        android:padding="@dimen/toolbar_icon_padding"
        android:src="@drawable/ic_sources"
        android:tint="#FFFFFF" />

    <LinearLayout
        android:id="@+id/source_panel"
        android:layout_width="@dimen/source_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F2161B20"
        android:orientation="vertical"
        android:padding="@dimen/source_panel_padding"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/source_mode_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/toolbar_button_size"
                android:layout_weight="1"
                android:background="@drawable/round_button"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/mode_ndi"
                android:textAllCaps="false"
                android:contentDescription="@string/choose_mode"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/source_title_size"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/scan_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:padding="@dimen/toolbar_icon_padding"
                android:background="@drawable/round_button"
                android:contentDescription="@string/refresh_sources"
                android:nextFocusDown="@id/source_list"
                android:src="@drawable/ic_refresh"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/monitor_settings_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:padding="@dimen/toolbar_icon_padding"
                android:background="@drawable/round_button"
                android:contentDescription="@string/monitor_settings"
                android:nextFocusDown="@id/source_list"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/close_panel_button"
                android:layout_width="@dimen/toolbar_button_size"
                android:layout_height="@dimen/toolbar_button_size"
                android:padding="@dimen/toolbar_icon_padding"
                android:background="@drawable/round_button"
                android:contentDescription="@string/close"
                android:nextFocusDown="@id/source_list"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/source_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/searching_sources"
            android:accessibilityLiveRegion="polite"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#B8FFFFFF"
            android:textSize="@dimen/source_status_size" />

        <ListView
            android:id="@+id/source_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="#2FFFFFFF"
            android:dividerHeight="1dp"
            android:nextFocusUp="@id/scan_button"
            android:listSelector="@drawable/list_selector" />

        <ScrollView
            android:id="@+id/html_form"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/html_address"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/html_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="4dp"
                    android:inputType="textUri|textNoSuggestions"
                    android:importantForAutofill="no"
                    android:singleLine="true"
                    android:imeOptions="actionGo"
                    android:hint="@string/html_address_hint"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8FFFFFF"
                    android:backgroundTint="#00B7FF"
                    android:textSize="14sp"
                    android:nextFocusDown="@id/open_html_button" />

                <Button
                    android:id="@+id/open_html_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/primary_button"
                    android:text="@string/open_html"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:nextFocusUp="@id/html_url" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="@string/ndi_attribution"
            android:textColor="#B8FFFFFF"
            android:textColorLink="#00B7FF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
