<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/spresenter_api_instructions" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/spresenter_api_address" />
        <EditText android:id="@+id/spresenter_api_address" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:singleLine="true" android:inputType="textUri|textNoSuggestions"
            android:importantForAutofill="no" android:hint="@string/spresenter_api_address_hint"
            android:nextFocusDown="@id/spresenter_api_token" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/spresenter_api_key" />
        <EditText android:id="@+id/spresenter_api_token" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:singleLine="true" android:inputType="textPassword|textNoSuggestions"
            android:importantForAutofill="no" android:saveEnabled="false"
            android:hint="@string/spresenter_api_key_hint" android:imeOptions="actionDone"
            android:nextFocusDown="@id/spresenter_api_save" />
        <Button android:id="@+id/spresenter_api_save" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/spresenter_api_save" android:textAllCaps="false" />
        <Button android:id="@+id/spresenter_api_remove" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/spresenter_api_remove" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
